# @title PotScore分组计算 PotScore（避免内存不足重启）

import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
import gc

file_path = '/content/EEIndex2025JanAugu.xlsx'
output_path = '/content/EEIndex2025JanAugu_with_PotScore.csv'   # 建议保存为 CSV 以减少内存

# 只读取后续必需的列（根据实际字段名调整）
usecols = [
    '代码', '名称', '日期', 'PB', 'PE', 'ROE', 'DY', 'PG', 'RG', 'YC',
    'Price', 'TR', 'DA', 'Percent', 'North', 'TShare', 'FShare', 'Amount'
]

# 分块读取？Excel 不支持分块读取，所以先读取成 DataFrame，但只保留必要列
print("正在读取 Excel 文件（仅必要列）...")
df = pd.read_excel(file_path, sheet_name='All', usecols=usecols)

# 统一代码格式
df['代码'] = df['代码'].astype(str).str.zfill(6)
df['日期'] = pd.to_datetime(df['日期'])

# 按股票代码分组，逐组处理
grouped = df.groupby('代码')
results = []

total_groups = len(grouped)
for i, (code, group) in enumerate(grouped):
    # 确保按日期升序
    group = group.sort_values('日期')

    # ---- 计算衍生指标（移动平均和斜率） ----
    # 由于数据量小，可以直接用 rolling
    for w in [5, 20]:
        # Price MA & Slope
        group[f'Price{w}-day-MA'] = group['Price'].rolling(w, min_periods=1).mean()
        group[f'Price{w}-day-Slope'] = group[f'Price{w}-day-MA'].diff()

        # Amount MA & Slope
        group[f'Amount{w}-day-MA'] = group['Amount'].rolling(w, min_periods=1).mean()
        group[f'Amount{w}-day-Slope'] = group[f'Amount{w}-day-MA'].diff()

        # DA MA（无斜率）
        group[f'DA{w}-day-MA'] = group['DA'].rolling(w, min_periods=1).mean()

        # TR MA（无斜率）
        group[f'TR{w}-day-MA'] = group['TR'].rolling(w, min_periods=1).mean()

    # ---- 准备计算 PotScore 的指标 ----
    selected_columns = [
        'PE', 'PB', 'ROE', 'DY', 'PG', 'RG', 'YC',
        'Price5-day-Slope', 'Amount5-day-Slope', 'Price20-day-Slope', 'Amount20-day-Slope',
        'DA5-day-MA', 'DA20-day-MA', 'TR5-day-MA', 'TR20-day-MA'
    ]
    key = group[selected_columns].copy()

    # 缺失值处理（与原逻辑一致）
    condition = (key['PB'].notnull()) & (key['ROE'].notnull()) & (key['ROE'] != 0)
    key.loc[condition, 'PE'] = key.loc[condition, 'PE'].fillna(key['PB'] / key['ROE'] * 100)
    key['DY'] = key['DY'].fillna(0)
    key['PG'] = key['PG'].fillna(-20.001)

    # 删除仍有缺失的行，并记录有效索引
    valid_idx = key.dropna().index
    if len(valid_idx) == 0:
        group['Potential_Score'] = np.nan
    else:
        # 处理 inf
        for col in ['Amount5-day-Slope', 'Amount20-day-Slope']:
            key.loc[key[col] == float('inf'), col] = 0
            key.loc[key[col] == float('-inf'), col] = 0

        # 标准化并计算得分
        scaler = StandardScaler()
        scaled = scaler.fit_transform(key.loc[valid_idx])
        # PE 方向调整（第一列为 PE）
        scaled[:, 0] = np.where(scaled[:, 0] > 0, scaled[:, 0] * -1, scaled[:, 0])
        # PB 乘以 -0.5（第二列为 PB）
        scaled[:, 1] = scaled[:, 1] * -0.5
        scores = scaled.mean(axis=1)

        # 将得分赋回 group
        group.loc[valid_idx, 'Potential_Score'] = scores

    # 将 Potential_Score 插入到“名称”之后
    name_idx = group.columns.get_loc('名称')
    score_col = group['Potential_Score']
    group.drop(columns=['Potential_Score'], inplace=True)
    group.insert(name_idx + 1, 'Potential_Score', score_col)

    # 收集结果
    results.append(group)

    # 每处理 500 个股票，强制垃圾回收并打印进度
    if (i+1) % 500 == 0:
        gc.collect()
        print(f"已处理 {i+1}/{total_groups} 只股票")

# 合并所有组
final_df = pd.concat(results, ignore_index=True)

# 排序：代码升序，日期倒序
final_df['代码'] = final_df['代码'].astype(str).str.zfill(6)
final_df['日期'] = final_df['日期'].dt.strftime('%Y-%m-%d')
final_df.sort_values(['代码', '日期'], ascending=[True, False], inplace=True)

# 保存为 CSV（比 Excel 更节省内存，可后续转 Excel）
final_df.to_csv(output_path, index=False, encoding='utf-8-sig')
print(f"✅ 已保存至 {output_path}")

# 如需 Excel，可再转换（但注意内存）
