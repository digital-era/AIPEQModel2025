# @title 从 GitHub 获取 fund_flow_group 时间段，生成对应 potscore_group 并提交

import pandas as pd
import os
import re
import glob
import shutil
import subprocess

# =========================
# 配置信息（请使用新 Token）
# =========================
GIT_USERNAME = "digital-era"
GIT_EMAIL = "digital_era@sina.com"
GIT_REPO_NAME = "AIPEQModel2025"
GIT_TARGET_BRANCH = "main"          # 若为 master 请修改
GIT_PAT = ""             # ⚠️ 请替换为你的新 Personal Access Token

repo_directory = f'/content/{GIT_REPO_NAME}'
data_directory = os.path.join(repo_directory, 'data')

# CSV 文件路径
csv_path = '/content/EEIndex2025JanAugu_with_PotScore.csv'
output_dir = '/content/potscore_groups'
os.makedirs(output_dir, exist_ok=True)

# =========================
# 1. 克隆仓库（如果本地不存在）
# =========================
if not os.path.exists(repo_directory):
    print(f"🚀 克隆仓库 {GIT_REPO_NAME} ...")
    clone_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
    result = subprocess.run(['git', 'clone', clone_url, repo_directory],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("克隆失败：", result.stderr)
        raise SystemExit
else:
    print(f"📁 仓库已存在，使用本地目录：{repo_directory}")

os.chdir(repo_directory)

# =========================
# 2. 获取所有 fund_flow_group_*.xlsx 文件名，解析起止日期
# =========================
fund_flow_files = glob.glob(os.path.join(data_directory, 'fund_flow_group_*.xlsx'))
if not fund_flow_files:
    raise FileNotFoundError("未找到任何 fund_flow_group_*.xlsx 文件")

print(f"找到 {len(fund_flow_files)} 个 fund_flow_group 文件")

# 存储每个文件的时间段（倒序：start >= end）
time_ranges = []  # 元素为 (start_date_str, end_date_str)  格式 YYYYMMDD
for file_path in fund_flow_files:
    basename = os.path.basename(file_path)
    # 使用正则提取 fund_flow_group_YYYYMMDD_YYYYMMDD.xlsx 中的两个日期
    match = re.match(r'fund_flow_group_(\d{8})_(\d{8})\.xlsx', basename)
    if not match:
        print(f"⚠️ 无法解析文件名：{basename}，跳过")
        continue
    start_date = match.group(1)  # 较新日期
    end_date = match.group(2)    # 较旧日期
    time_ranges.append((start_date, end_date))
    print(f"  时间段：{start_date} ~ {end_date}  (来自 {basename})")

# =========================
# 3. 读取 CSV 数据
# =========================
print("正在读取 CSV 文件...")
df = pd.read_csv(csv_path, dtype={'代码': str})
print(f"读取完成，共 {len(df)} 条记录")

# 统一代码为 6 位字符串
df['代码'] = df['代码'].str.zfill(6)

# 将日期列转换为字符串并生成 YYYYMMDD 列用于筛选
df['日期'] = df['日期'].astype(str)
df['日期_YYYYMMDD'] = df['日期'].str.replace('-', '')  # 若日期格式为 YYYY-MM-DD

# =========================
# 4. 按时间段筛选并保存 potscore_group 文件
# =========================
for start_date, end_date in time_ranges:
    print(f"\n处理时间段：{start_date} ~ {end_date}")
    # 筛选日期在 [end_date, start_date] 之间的记录（注意 start >= end，且包含两端）
    mask = (df['日期_YYYYMMDD'] >= end_date) & (df['日期_YYYYMMDD'] <= start_date)
    group_df = df[mask].copy()

    if group_df.empty:
        print("  该时间段无数据，跳过")
        continue

    # 删除辅助列
    group_df.drop(columns=['日期_YYYYMMDD'], inplace=True)

    # 排序：代码升序，日期字符串倒序
    group_df.sort_values(['代码', '日期'], ascending=[True, False], inplace=True)

    # 保存为 xlsx
    output_file = os.path.join(output_dir, f'potscore_group_{start_date}_{end_date}.xlsx')
    group_df.to_excel(output_file, index=False, engine='openpyxl')
    print(f"  ✅ 已保存 {output_file}（{len(group_df)} 行）")

print("\n✅ 所有 potscore_group 文件生成完毕")

# =========================
# 5. 复制文件到仓库 data 目录并提交推送
# =========================
# 确保 data 目录存在
os.makedirs(data_directory, exist_ok=True)

# 复制所有生成的 potscore_group 文件
generated_files = glob.glob(os.path.join(output_dir, 'potscore_group_*.xlsx'))
if not generated_files:
    raise FileNotFoundError("未生成任何 potscore_group 文件")

print(f"\n复制 {len(generated_files)} 个文件到仓库 data 目录...")
for file_path in generated_files:
    shutil.copy2(file_path, data_directory)
    print(f"  ✅ 复制 {os.path.basename(file_path)}")

# =========================
# 6. Git 提交与推送
# =========================
subprocess.run(['git', 'config', 'user.name', GIT_USERNAME], check=True)
subprocess.run(['git', 'config', 'user.email', GIT_EMAIL], check=True)

subprocess.run(['git', 'add', 'data/potscore_group_*.xlsx'], check=True)

status = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True)
if status.stdout.strip():
    commit_message = "Add potscore group xlsx files (matching fund_flow periods)"
    subprocess.run(['git', 'commit', '-m', commit_message], check=True)
    print("✅ 已提交本地 commit")

    push_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
    print("推送中...")
    result = subprocess.run(['git', 'push', push_url, GIT_TARGET_BRANCH],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("推送失败，错误信息：")
        print(result.stderr)
        # 尝试 master 分支
        print("尝试 master 分支...")
        result2 = subprocess.run(['git', 'push', push_url, 'master'],
                                 capture_output=True, text=True)
        if result2.returncode != 0:
            print("master 分支也失败：", result2.stderr)
        else:
            print("✅ 推送成功（master 分支）")
    else:
        print("✅ 推送成功（main 分支）")
else:
    print("ℹ️ 没有新的变更，无需提交。")

print("\n🏁 任务完成。")


# @title 生成 EEIFlow 文件（更新 PotScore + 排序 Sheet）并提交到 GitHub

import pandas as pd
import os
import re
import glob
import shutil
import subprocess

# =========================
# 配置信息（请使用新 Token）
# =========================
GIT_USERNAME = "digital-era"
GIT_EMAIL = "digital_era@sina.com"
GIT_REPO_NAME = "AIPEQModel2025"
GIT_TARGET_BRANCH = "main"          # 若为 master 请修改
GIT_PAT = ""             # ⚠️ 请替换为你的新 Personal Access Token

repo_directory = f'/content/{GIT_REPO_NAME}'
data_directory = os.path.join(repo_directory, 'data')
output_dir = '/content/EEIFlow'     # 临时存放生成的新文件
os.makedirs(output_dir, exist_ok=True)

# =========================
# 1. 克隆仓库（如果本地不存在）
# =========================
if not os.path.exists(repo_directory):
    print(f"🚀 克隆仓库 {GIT_REPO_NAME} ...")
    clone_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
    result = subprocess.run(['git', 'clone', clone_url, repo_directory],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("克隆失败：", result.stderr)
        raise SystemExit
else:
    print(f"📁 仓库已存在，使用本地目录：{repo_directory}")

os.chdir(repo_directory)

# =========================
# 2. 获取所有 fund_flow_group_*.xlsx 文件
# =========================
fund_flow_files = glob.glob(os.path.join(data_directory, 'fund_flow_group_*.xlsx'))
if not fund_flow_files:
    raise FileNotFoundError("未找到任何 fund_flow_group_*.xlsx 文件")

print(f"找到 {len(fund_flow_files)} 个 fund_flow_group 文件")

# =========================
# 3. 逐个处理，生成新的 EEIFlow 文件（包含 Flow5Days 和 Flow5DaysSort）
# =========================
generated_files = []  # 记录生成的文件路径
for file_path in fund_flow_files:
    basename = os.path.basename(file_path)
    # 解析时间段
    match = re.match(r'fund_flow_group_(\d{8})_(\d{8})\.xlsx', basename)
    if not match:
        print(f"⚠️ 无法解析文件名：{basename}，跳过")
        continue
    start_date, end_date = match.group(1), match.group(2)

    potscore_file = os.path.join(data_directory, f'potscore_group_{start_date}_{end_date}.xlsx')
    if not os.path.exists(potscore_file):
        print(f"⚠️ 找不到对应的 PotScore 文件：{os.path.basename(potscore_file)}，跳过 {basename}")
        continue

    print(f"\n处理 {basename} ...")
    # 读取 fund_flow_group 的 Flow5Days sheet
    df_flow = pd.read_excel(file_path, sheet_name='Flow5Days')
    # 读取 potscore_group 的 Sheet1
    df_pot = pd.read_excel(potscore_file)

    # 检查必要列
    if '代码' not in df_flow.columns or '日期' not in df_flow.columns or 'PotScore' not in df_flow.columns:
        print(f"   ❌ fund_flow_group 缺少必要列，跳过")
        continue
    if '代码' not in df_pot.columns or '日期' not in df_pot.columns or 'Potential_Score' not in df_pot.columns:
        print(f"   ❌ potscore_group 缺少必要列，跳过")
        continue

    # 统一代码和日期格式
    df_flow['代码'] = df_flow['代码'].astype(str).str.zfill(6)
    df_pot['代码'] = df_pot['代码'].astype(str).str.zfill(6)
    df_flow['日期'] = df_flow['日期'].astype(str)
    df_pot['日期'] = df_pot['日期'].astype(str)

    # 提取 potscore 中的唯一映射
    df_pot_unique = df_pot[['代码', '日期', 'Potential_Score']].drop_duplicates(subset=['代码', '日期'])

    # 合并，用 Potential_Score 更新 PotScore
    df_updated = pd.merge(
        df_flow,
        df_pot_unique,
        on=['代码', '日期'],
        how='left'
    )
    # 若匹配到 Potential_Score，则覆盖 PotScore；否则保留原 PotScore
    if 'Potential_Score' in df_updated.columns:
        df_updated['PotScore'] = df_updated['Potential_Score'].fillna(df_updated['PotScore'])
        df_updated.drop(columns=['Potential_Score'], inplace=True)
    else:
        print(f"   ⚠️ 未找到 Potential_Score 列，不更新该文件")
        continue

    # 生成排序后的 DataFrame
    sort_col = '总净流入占比_5日总和'
    if sort_col in df_updated.columns:
        df_sorted = df_updated.sort_values(
            by=[sort_col, '代码', '日期'],
            ascending=[False, False, False]
        )
    else:
        print(f"   ⚠️ 缺少排序列 {sort_col}，仅写入 Flow5Days，不生成 Flow5DaysSort")
        df_sorted = None

    # 保存为新文件（同时写入两个 sheet）
    new_filename = f"EEIFlow_{start_date}_{end_date}.xlsx"
    new_filepath = os.path.join(output_dir, new_filename)
    with pd.ExcelWriter(new_filepath, engine='openpyxl') as writer:
        df_updated.to_excel(writer, sheet_name='Flow5Days', index=False)
        if df_sorted is not None:
            df_sorted.to_excel(writer, sheet_name='Flow5DaysSort', index=False)
    print(f"   ✅ 已生成新文件：{new_filename} (包含 Flow5Days 和 Flow5DaysSort)")
    generated_files.append(new_filepath)

if not generated_files:
    print("\n没有生成任何新文件，任务结束。")
else:
    print(f"\n共生成 {len(generated_files)} 个新文件，开始复制到仓库...")

    # =========================
    # 4. 复制生成的文件到仓库 data 目录
    # =========================
    for src in generated_files:
        shutil.copy2(src, data_directory)
        print(f"   ✅ 复制 {os.path.basename(src)} 到 data 目录")

    # =========================
    # 5. 提交并推送
    # =========================
    subprocess.run(['git', 'config', 'user.name', GIT_USERNAME], check=True)
    subprocess.run(['git', 'config', 'user.email', GIT_EMAIL], check=True)

    # 添加新文件
    subprocess.run(['git', 'add', 'data/EEIFlow_*.xlsx'], check=True)

    status = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True)
    if status.stdout.strip():
        commit_message = "Add EEIFlow files with updated PotScore and sorted sheet"
        subprocess.run(['git', 'commit', '-m', commit_message], check=True)
        print("✅ 已提交本地 commit")

        push_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
        print("推送中...")
        result = subprocess.run(['git', 'push', push_url, GIT_TARGET_BRANCH],
                                capture_output=True, text=True)
        if result.returncode != 0:
            print("推送失败，错误信息：")
            print(result.stderr)
            # 尝试 master 分支
            print("尝试 master 分支...")
            result2 = subprocess.run(['git', 'push', push_url, 'master'],
                                     capture_output=True, text=True)
            if result2.returncode != 0:
                print("master 分支也失败：", result2.stderr)
            else:
                print("✅ 推送成功（master 分支）")
        else:
            print("✅ 推送成功（main 分支）")
    else:
        print("ℹ️ 没有检测到新文件变更，可能已提交。")

print("\n🏁 任务完成。")


