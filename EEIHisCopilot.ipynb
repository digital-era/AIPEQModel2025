# @title Each Day Initilize stock_data_list
stock_data_list = [] # 用于存储每个股票的数据和排序指标


# @title Get Fund Flow by 5-Day Groups (2025-01-01 ~ 2025-09-15)
!pip install tushare
import tushare as ts
import pandas as pd
import numpy as np
import time
import os
import pickle
from datetime import datetime, timedelta
import shutil
import pytz

# =========================
# 基础配置
# =========================
TS_TOKEN = "18592c39e9b5e8319cefadf056b3fc8d87c83579c7ca375f26de087c"          # 请填入你的 Tushare Pro Token
ts.set_token(TS_TOKEN)
pro = ts.pro_api()

# 目标日期范围
START_DATE = '20250101'
END_DATE   = '20250915'

# 分组大小（每5个交易日一组）
GROUP_SIZE = 5

# =========================
# 持久化输出函数（写入 Excel）
# =========================
def FlowPersitence(stock_data_list, excel_file):
    writer = pd.ExcelWriter(excel_file, engine='openpyxl')
    all_stock_data = pd.DataFrame()

    for i, stock_data in enumerate(stock_data_list):
        stock_code = stock_data["代码"]
        stock_name = stock_data["名称"]
        PotScore = round(stock_data["PotScore"], 2)
        total_net_inflow_ratio = stock_data["总净流入占比_5日总和"]
        df_recent = stock_data["区间数据"].copy()   # 使用“区间数据”键

        try:
            if '日期' not in df_recent.columns:
                print(f"{stock_code}{stock_name} Error: 日期 column not found.")
                continue

            if not pd.api.types.is_datetime64_any_dtype(df_recent['日期']):
                df_recent['日期'] = pd.to_datetime(df_recent['日期'])

            df_recent['日期'] = df_recent['日期'].dt.strftime('%Y-%m-%d')
        except Exception as e:
            print(f"{stock_code}{stock_name} Error: {e}")
            continue

        # 添加股票标识列
        df_recent['代码'] = stock_code
        df_recent['名称'] = stock_name
        df_recent['PotScore'] = PotScore
        df_recent['总净流入占比_5日总和'] = total_net_inflow_ratio

        # 调整列顺序
        first_cols = ['代码', '名称', 'PotScore', '总净流入占比_5日总和']
        other_cols = [col for col in df_recent.columns if col not in first_cols]
        df_recent = df_recent[first_cols + other_cols]

        all_stock_data = pd.concat([all_stock_data, df_recent], ignore_index=True)

    all_stock_data.to_excel(writer, sheet_name='Flow5Days', index=False)
    writer.close()
    print(f"✅ 数据已写入: {excel_file}")

# =========================
# 获取交易日历
# =========================
print(f"📅 获取 {START_DATE} 至 {END_DATE} 的交易日历...")
cal_sse = pro.trade_cal(exchange='SSE', start_date=START_DATE, end_date=END_DATE, is_open='1')[['cal_date']]
cal_szse = pro.trade_cal(exchange='SZSE', start_date=START_DATE, end_date=END_DATE, is_open='1')[['cal_date']]

cal = pd.concat([cal_sse, cal_szse]).drop_duplicates().sort_values('cal_date', ascending=False)
trade_dates = cal['cal_date'].tolist()
print(f"共 {len(trade_dates)} 个交易日，将按每 {GROUP_SIZE} 天分组")

# =========================
# 拉取全市场资金流数据（所有交易日，一次拉取）
# =========================
print("📥 拉取全市场资金流数据...")
all_days_data = []
for i, d in enumerate(trade_dates):
    for attempt in range(3):
        try:
            df = pro.moneyflow(trade_date=d)
            if df is not None and not df.empty:
                df['trade_date'] = d
                all_days_data.append(df)
                print(f"  ✅ {d} 成功，获取 {len(df)} 条 (进度 {i+1}/{len(trade_dates)})")
            else:
                print(f"  ℹ️ {d} 无数据")
            time.sleep(1.2)
            break
        except Exception as e:
            wait = 3 * (attempt + 1)
            print(f"  ❌ {d} 失败，重试 {attempt+1}/3，等待 {wait}s，错误：{e}")
            time.sleep(wait)

if not all_days_data:
    raise ValueError("没有获取到任何资金流数据")

moneyflow_df = pd.concat(all_days_data, ignore_index=True)
print(f"✅ 资金流数据合并完成，总条数：{len(moneyflow_df)}")

# =========================
# 拉取每日行情数据
# =========================
print("📥 拉取每日行情数据...")
all_daily = []
for i, d in enumerate(trade_dates):
    for attempt in range(3):
        try:
            df_daily = pro.daily(trade_date=d)
            if df_daily is not None and not df_daily.empty:
                df_daily['trade_date'] = d
                all_daily.append(df_daily)
                print(f"  ✅ {d} 行情成功，获取 {len(df_daily)} 条 (进度 {i+1}/{len(trade_dates)})")
            else:
                print(f"  ℹ️ {d} 行情无数据")
            time.sleep(0.8)
            break
        except Exception as e:
            wait = 3 * (attempt + 1)
            print(f"  ❌ {d} 行情失败，重试 {attempt+1}/3，等待 {wait}s，错误：{e}")
            time.sleep(wait)

if not all_daily:
    print("⚠️ 未获取到行情数据，收盘价和涨跌幅将为空")
    daily_df = pd.DataFrame()
else:
    daily_df = pd.concat(all_daily, ignore_index=True)
    daily_df['代码'] = daily_df['ts_code'].str.replace('.SZ', '').str.replace('.SH', '')
    daily_df['日期'] = pd.to_datetime(daily_df['trade_date'])
    daily_df = daily_df[['代码', '日期', 'close', 'pct_chg']].rename(columns={'close': '收盘价', 'pct_chg': '涨跌幅'})
    print(f"✅ 行情数据合并完成，总条数：{len(daily_df)}")

# =========================
# 合并行情到资金流
# =========================
moneyflow_df['代码'] = moneyflow_df['ts_code'].str.replace('.SZ', '').str.replace('.SH', '')
moneyflow_df['日期'] = pd.to_datetime(moneyflow_df['trade_date'])

if not daily_df.empty:
    moneyflow_df = moneyflow_df.merge(daily_df, on=['代码', '日期'], how='left')
else:
    moneyflow_df['收盘价'] = np.nan
    moneyflow_df['涨跌幅'] = np.nan

# =========================
# 准备目标股票列表（如果存在）
# =========================
if 'target_EEIARTop_data' not in globals() or target_EEIARTop_data is None:
    raise ValueError("请先定义 target_EEIARTop_data（包含 代码、名称、Potential_Score 列）")

target_codes = target_EEIARTop_data["代码"].astype(str).str.zfill(6).tolist()
print(f"目标股票数量: {len(target_codes)}")

# 过滤资金流数据，只保留目标股票，减少后续处理量
moneyflow_df = moneyflow_df[moneyflow_df['代码'].isin(target_codes)]

# =========================
# 按每5个交易日分组处理
# =========================
required_columns = [
    "日期", "收盘价", "涨跌幅",
    "主力净流入-净额", "主力净流入-净占比",
    "超大单净流入-净额", "超大单净流入-净占比",
    "大单净流入-净额", "大单净流入-净占比",
    "中单净流入-净额", "中单净流入-净占比",
    "小单净流入-净额", "小单净流入-净占比",
    "总净流入占比"
]

groups = []
for i in range(0, len(trade_dates), GROUP_SIZE):
    group_dates = trade_dates[i:i+GROUP_SIZE]
    groups.append(group_dates)

print(f"\n共分成 {len(groups)} 组，每组最多 {GROUP_SIZE} 个交易日")

for gi, group_dates in enumerate(groups):
    group_start = group_dates[0]
    group_end = group_dates[-1]
    print(f"\n{'='*50}")
    print(f"处理第 {gi+1}/{len(groups)} 组：{group_start} ~ {group_end}")

    # 筛选该组日期的数据
    group_mask = moneyflow_df['trade_date'].isin(group_dates)
    group_df = moneyflow_df[group_mask].copy()
    if group_df.empty:
        print("该组无数据，跳过")
        continue

    # 初始化该组的结果列表
    stock_data_list_group = []

    for code in target_codes:
        # 从目标表中获取股票信息
        row = target_EEIARTop_data[target_EEIARTop_data["代码"] == code]
        if row.empty:
            continue
        row = row.iloc[0]
        name = row["名称"]
        potscore = row["Potential_Score"]

        # 提取该股票在该组内的数据
        df_stock = group_df[group_df["代码"] == code].copy()

        if df_stock.empty:
            # 无数据，添加占位记录（可选）
            stock_data_list_group.append({
                "代码": code,
                "名称": name,
                "PotScore": potscore,
                "总净流入占比_5日总和": float('-inf'),
                "区间数据": pd.DataFrame()
            })
            continue

        # 按日期升序排列（便于时间顺序展示）
        df_stock = df_stock.sort_values("日期", ascending=True).copy()

        # 计算成交额（买入总额，万元）
        df_stock['amount'] = df_stock[['buy_sm_amount', 'buy_md_amount', 'buy_lg_amount', 'buy_elg_amount']].sum(axis=1)
        df_stock['amount'] = df_stock['amount'].replace(0, np.nan)

        # 计算各类型净流入额（万元）
        df_stock["超大单净流入-净额"] = df_stock["buy_elg_amount"] - df_stock["sell_elg_amount"]
        df_stock["大单净流入-净额"]   = df_stock["buy_lg_amount"] - df_stock["sell_lg_amount"]
        df_stock["中单净流入-净额"]   = df_stock["buy_md_amount"] - df_stock["sell_md_amount"]
        df_stock["小单净流入-净额"]   = df_stock["buy_sm_amount"] - df_stock["sell_sm_amount"]
        df_stock["主力净流入-净额"]   = df_stock["超大单净流入-净额"] + df_stock["大单净流入-净额"]

        # 计算净占比（%）
        for col in ["主力", "超大单", "大单", "中单", "小单"]:
            df_stock[f"{col}净流入-净占比"] = (df_stock[f"{col}净流入-净额"] / df_stock["amount"]) * 100

        df_stock["总净流入占比"] = df_stock["主力净流入-净占比"] + df_stock["超大单净流入-净占比"]

        # 处理缺失值、单位转换、保留小数
        ratio_cols = ["主力净流入-净占比", "超大单净流入-净占比", "大单净流入-净占比",
                      "中单净流入-净占比", "小单净流入-净占比", "总净流入占比"]
        df_stock[ratio_cols] = df_stock[ratio_cols].fillna(0)

        amount_cols = ["主力净流入-净额", "超大单净流入-净额", "大单净流入-净额",
                       "中单净流入-净额", "小单净流入-净额"]
        for col in amount_cols:
            df_stock[col] = df_stock[col] * 10000   # 万元转元

        pct_cols = ["涨跌幅", "主力净流入-净占比", "超大单净流入-净占比", "大单净流入-净占比",
                    "中单净流入-净占比", "小单净流入-净占比", "总净流入占比"]
        df_stock[pct_cols] = df_stock[pct_cols].round(2)

        # 计算该组内总净流入占比总和（即5日总和，若不足5天则为实际天数总和）
        total_ratio = df_stock["总净流入占比"].sum()

        recent_data = df_stock[required_columns].copy()
        recent_data.reset_index(drop=True, inplace=True)

        stock_data_list_group.append({
            "代码": code,
            "名称": name,
            "PotScore": potscore,
            "总净流入占比_5日总和": total_ratio,
            "区间数据": recent_data
        })

    # 保存该组结果：pkl 和 xlsx
    pkl_file = f"fund_flow_group_{group_start}_{group_end}.pkl"
    xlsx_file = f"fund_flow_group_{group_start}_{group_end}.xlsx"

    with open(pkl_file, "wb") as f:
        pickle.dump(stock_data_list_group, f)
    FlowPersitence(stock_data_list_group, xlsx_file)

    print(f"✅ 第 {gi+1} 组已保存：{pkl_file} 和 {xlsx_file}")

print("\n🎉 所有分组处理完成！")



# @title 提交 fund_flow_group Excel文件 到 GitHub AIPEQModel2025 data 目录

import os
import shutil
import glob
import subprocess

# =========================
# 配置信息（请确认已填写真实的 PAT）
# =========================
GIT_USERNAME = "digital-era"
GIT_EMAIL = "digital_era@sina.com"
GIT_REPO_NAME = "AIPEQModel2025"
GIT_TARGET_BRANCH = "main"
GIT_PAT = ""  # ⚠️ 请替换为你的真实 Personal Access Token

# 本地仓库路径
repo_directory = f'/content/{GIT_REPO_NAME}'
data_directory = os.path.join(repo_directory, 'data')

# =========================
# 1. 克隆仓库（如果本地不存在）
# =========================
if not os.path.exists(repo_directory):
    print(f"🚀 克隆仓库 {GIT_REPO_NAME} ...")
    clone_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
    subprocess.run(['git', 'clone', clone_url, repo_directory], check=True)
else:
    print(f"📁 仓库已存在，使用本地目录：{repo_directory}")

# 切换到仓库目录
os.chdir(repo_directory)

# =========================
# 2. 设置 git 用户信息（如果尚未设置）
# =========================
subprocess.run(['git', 'config', 'user.name', GIT_USERNAME], check=True)
subprocess.run(['git', 'config', 'user.email', GIT_EMAIL], check=True)

# =========================
# 3. 确保 data 目录存在
# =========================
if not os.path.exists(data_directory):
    os.makedirs(data_directory)
    print(f"📂 创建目录：{data_directory}")

# =========================
# 4. 复制所有 fund_flow_group_*.xlsx 文件到 data 目录
# =========================
source_pattern = '/content/fund_flow_group_*.xlsx'
files_to_copy = glob.glob(source_pattern)

if not files_to_copy:
    print("⚠️ 未找到任何以 fund_flow_group_ 开头的 .xlsx 文件，请确认文件位置。")
else:
    print(f"📄 发现 {len(files_to_copy)} 个文件，开始复制...")
    for file_path in files_to_copy:
        file_name = os.path.basename(file_path)
        dest_path = os.path.join(data_directory, file_name)
        shutil.copy2(file_path, dest_path)
        print(f"   ✅ 已复制：{file_name}")

    # =========================
    # 5. 提交并推送
    # =========================
    print("\n📦 准备提交到 GitHub...")
    subprocess.run(['git', 'add', 'data/*.xlsx'], check=True)
    
    # 检查是否有变更
    status = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True)
    if status.stdout.strip():
        commit_message = "Add fund flow group xlsx files"
        subprocess.run(['git', 'commit', '-m', commit_message], check=True)
        print("✅ 已提交本地 commit")

        # 推送
        push_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
        subprocess.run(['git', 'push', push_url, GIT_TARGET_BRANCH], check=True)
        print("🎉 推送成功！")
    else:
        print("ℹ️ 没有新的变更，无需提交。")

print("\n🏁 任务完成。")


# @title 从 pkl 提取资金流 + Excel 提取基本面 + 计算振幅 DA，生成 EEIndex2025JanAugu.xlsx

import pandas as pd
import numpy as np
import glob
import os
import time
import pickle
from datetime import datetime
import tushare as ts

# =========================
# 高效从 Excel 提取指定日期、指定字段的函数
# =========================
def load_fields_from_excel(excel_path, target_date, fields, sheet_name='All', codes_filter=None):
    from openpyxl import load_workbook
    wb = load_workbook(excel_path, read_only=True, data_only=True)
    ws = wb[sheet_name]

    headers = [cell.value for cell in next(ws.iter_rows(min_row=1, max_row=1))]
    all_needed = ['代码', '日期'] + fields
    col_indices = {col: headers.index(col) for col in all_needed if col in headers}
    missing = [c for c in all_needed if c not in col_indices]
    if missing:
        wb.close()
        raise ValueError(f"Excel 中缺少必要列: {missing}")

    code_idx = col_indices['代码']
    date_idx = col_indices['日期']
    field_indices = {f: col_indices[f] for f in fields}

    records = []
    for row in ws.iter_rows(min_row=2, values_only=True):
        date_val = row[date_idx]
        if isinstance(date_val, pd.Timestamp):
            date_str = date_val.strftime('%Y-%m-%d')
        elif isinstance(date_val, datetime):
            date_str = date_val.strftime('%Y-%m-%d')
        else:
            date_str = str(date_val).strip()[:10]

        if date_str != target_date:
            continue

        code_val = row[code_idx]
        code_str = str(int(code_val)).zfill(6) if isinstance(code_val, float) else str(code_val).strip().zfill(6)

        if codes_filter is not None and code_str not in codes_filter:
            continue

        record = {'代码': code_str}
        for f in fields:
            record[f] = row[field_indices[f]]
        records.append(record)

    wb.close()
    df = pd.DataFrame(records)
    df = df.drop_duplicates(subset=['代码'], keep='first')
    return df

# =========================
# 1. Tushare 初始化
# =========================
TS_TOKEN = "18592c39e9b5e8319cefadf056b3fc8d87c83579c7ca375f26de087c"  # ⚠️ 请填入你的 Tushare Pro Token
ts.set_token(TS_TOKEN)
pro = ts.pro_api()

# =========================
# 2. 读取所有 fund_flow_group_*.pkl 文件
# =========================
pkl_files = glob.glob('/content/fund_flow_group_*.pkl')
if not pkl_files:
    raise FileNotFoundError("未找到 fund_flow_group_*.pkl 文件")

print(f"找到 {len(pkl_files)} 个 pkl 文件")

records = []
for file in pkl_files:
    with open(file, 'rb') as f:
        stock_list = pickle.load(f)
    for item in stock_list:
        df = item.get('区间数据', pd.DataFrame())
        if df.empty:
            continue
        df = df.copy()
        df['代码'] = item['代码']
        df['名称'] = item['名称']
        df['日期'] = pd.to_datetime(df['日期']).dt.strftime('%Y-%m-%d')
        records.append(df[['代码', '名称', '日期', '收盘价', '涨跌幅']])

flow_base_df = pd.concat(records, ignore_index=True)
flow_base_df['代码'] = flow_base_df['代码'].astype(str).str.zfill(6)
flow_base_df.drop_duplicates(subset=['代码', '日期'], keep='first', inplace=True)

# =========================
# 3. 获取目标股票代码和交易日
# =========================
codes = flow_base_df['代码'].unique().tolist()
codes_set = set(codes)
dates = flow_base_df['日期'].unique().tolist()
trade_dates = [d.replace('-', '') for d in dates]
print(f"目标股票数：{len(codes)}，交易日数：{len(trade_dates)}")

# =========================
# 4. 从 Tushare 获取每日行情，用于 Price、Amount、DA
# =========================
print("📥 获取每日行情数据（daily）并计算 DA ...")
daily_dfs = []
for d in trade_dates:
    try:
        df_daily = pro.daily(trade_date=d)
        if df_daily is not None and not df_daily.empty:
            df_daily['代码'] = df_daily['ts_code'].str.replace('.SZ','').str.replace('.SH','')
            df_daily = df_daily[df_daily['代码'].isin(codes_set)]
            df_daily['日期'] = d
            daily_dfs.append(df_daily[['代码','日期','close','amount','high','low','pre_close']])
        time.sleep(0.5)
    except Exception as e:
        print(f"daily {d} 获取失败：{e}")

if not daily_dfs:
    raise ValueError("未获取到 daily 数据")
daily_all = pd.concat(daily_dfs, ignore_index=True)
daily_all['日期'] = pd.to_datetime(daily_all['日期']).dt.strftime('%Y-%m-%d')

# 计算振幅 DA（%）
daily_all['DA'] = np.where(
    daily_all['pre_close'] > 0,
    (daily_all['high'] - daily_all['low']) / daily_all['pre_close'] * 100,
    np.nan
)

# 整理字段：Price = 收盘价，Amount = 成交金额（亿元）
daily_all = daily_all.rename(columns={'close': 'Price', 'amount': 'Amount'})
daily_all['Amount'] = daily_all['Amount'] / 100000   # 千元 → 亿元

# 删除中间字段
daily_all = daily_all[['代码','日期','Price','Amount','DA']]

# =========================
# 5. 从 Excel 提取基本面字段（不含 DA）
# =========================
excel_path = '/content/EEIndex2025AuguDec.xlsx'
target_excel_date = '2025-08-01'
excel_fields = ['PB', 'PE', 'ROE', 'DY', 'PG', 'RG', 'TR', 'TShare', 'FShare']

print(f"📥 从 {excel_path} 提取基本面字段（日期 {target_excel_date}）...")
fundamental_df = load_fields_from_excel(
