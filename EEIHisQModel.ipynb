# @title 每日生成流入组合策略模型（循环所有交易日，滚动5日窗口）

import pandas as pd
import numpy as np
import scipy.optimize as sco
import re
import json
import os
from datetime import datetime, timedelta

# =========================
# 前置检查
# =========================
if 'df_combined' not in globals() or df_combined.empty:
    raise ValueError("❌ 错误：请先加载 df_combined（所有 EEIFlow 合并后的数据）")

# 统一日期格式并排序
df_combined['日期'] = pd.to_datetime(df_combined['日期'])
df_combined = df_combined.sort_values(['代码', '日期']).reset_index(drop=True)

# 确保代码为6位字符串
df_combined['代码'] = df_combined['代码'].astype(str).str.zfill(6)

# =========================
# 辅助函数定义
# =========================
def repair_json_file(file_path):
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content_str = f.read()
    except Exception as e:
        print(f"读取文件 {file_path} 失败: {str(e)}")
        return
    if not content_str.strip():
        print(f"文件 {file_path} 为空，无法修复。")
        return
    content_str_no_nan = re.sub(r'\bNaN\b', 'null', content_str, flags=re.IGNORECASE)
    try:
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content_str_no_nan)
        print(f"JSON文件格式校正完成: {file_path}")
    except Exception as e:
        print(f"写回文件 {file_path} 失败: {str(e)}")

def optimize_portfolio_sharpe(df_full_data, stock_codes, last_day_date, risk_free_rate=0.015):
    # --- 1. 数据预处理与防错 ---
    df_portfolio = df_full_data[df_full_data['代码'].isin(stock_codes)].copy()
    df_portfolio = df_portfolio.drop_duplicates(subset=['日期', '代码'])

    price_pivot = df_portfolio.pivot_table(index='日期', columns='代码', values='收盘价').sort_index()
    price_pivot.dropna(axis=1, how='all', inplace=True)

    if price_pivot.empty:
        print("错误：价格数据为空。")
        return None, None

    log_returns = np.log(price_pivot / price_pivot.shift(1)).dropna()
    if log_returns.empty:
        print("错误：无法计算收益率（数据不足）。")
        return None, None

    # --- 2. 优化计算 ---
    mean_returns = log_returns.mean() * 252
    cov_matrix = log_returns.cov() * 252

    valid_stock_codes = price_pivot.columns.tolist()
    num_assets = len(valid_stock_codes)

    def neg_sharpe_ratio(weights, mean_returns, cov_matrix, risk_free_rate):
        p_return = np.sum(mean_returns * weights)
        p_std = np.sqrt(np.dot(weights.T, np.dot(cov_matrix, weights)))
        return -(p_return - risk_free_rate) / p_std if p_std != 0 else -np.inf

    constraints = ({'type': 'eq', 'fun': lambda w: np.sum(w) - 1})
    bounds = tuple((0, 1) for _ in range(num_assets))
    initial_guess = num_assets * [1. / num_assets,]

    opt_result = sco.minimize(neg_sharpe_ratio, initial_guess, args=(mean_returns, cov_matrix, risk_free_rate),
                              method='SLSQP', bounds=bounds, constraints=constraints)

    if not opt_result.success:
        print("优化失败。")
        return None, None

    optimal_weights = opt_result.x
    opt_return = np.sum(mean_returns * optimal_weights)
    opt_volatility = np.sqrt(np.dot(optimal_weights.T, np.dot(cov_matrix, optimal_weights)))
    opt_sharpe = (opt_return - risk_free_rate) / opt_volatility if opt_volatility != 0 else np.nan

    results_df = pd.DataFrame({'代码': valid_stock_codes, '最优权重': optimal_weights})

    # --- 3. 提取最新数据并计算涨跌幅 ---
    latest_data = df_full_data[df_full_data['代码'].isin(valid_stock_codes)].copy()
    latest_data = latest_data[latest_data['日期'] <= last_day_date]
    latest_data = latest_data.sort_values(['代码', '日期'])

    last_two_days = latest_data.groupby('代码').tail(2)
    last_two_days['涨跌幅'] = last_two_days.groupby('代码')['收盘价'].pct_change() * 100

    final_latest_data = last_two_days.groupby('代码').tail(1).copy()
    final_latest_data.rename(columns={'收盘价': '最近一日价格'}, inplace=True)

    columns_to_merge_base = ['代码', '名称', '最近一日价格', '涨跌幅', 'PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
    columns_to_merge = [c for c in columns_to_merge_base if c in final_latest_data.columns]
    results_df = pd.merge(results_df, final_latest_data[columns_to_merge], on='代码', how='left')

    # --- 4. 格式化输出 ---
    results_df['最优权重(%)'] = results_df['最优权重'].apply(lambda x: f"{x*100:.2f}%")

    pct_cols = ['涨跌幅', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
    for col in pct_cols:
        if col in results_df.columns:
            results_df[f'{col}(%)'] = results_df[col].apply(lambda x: f"{x:.2f}%" if pd.notna(x) else "N/A")

    results_df = results_df.sort_values(by='最优权重', ascending=False)

    performance = {'预期年化收益率': opt_return, '年化波动率(风险)': opt_volatility, '预期夏普比率': opt_sharpe}
    results_df['最后一日日期'] = last_day_date.strftime('%Y-%m-%d')

    desired_cols = [
        '代码', '名称', '最后一日日期', '最优权重(%)', '最近一日价格',
        '涨跌幅(%)', 'PotScore', '总净流入占比_5日总和(%)',
        '主力净流入-净占比(%)', '超大单净流入-净占比(%)'
    ]
    output_columns = [c for c in desired_cols if c in results_df.columns]

    return results_df[output_columns], performance


class RiskControlFactor:
    """
    流入模型专用风控类（阈值已优化）
    """
    def __init__(self, df_combined):
        self.df_combined = df_combined.copy()
        self.market_proxy_dict = self._precompute_market_proxy()

    def _precompute_market_proxy(self):
        df = self.df_combined
        df['日期'] = pd.to_datetime(df['日期']).dt.normalize()
        if 'MA20' not in df.columns:
            df = df.sort_values(['代码', '日期'])
            df['MA20'] = df.groupby('代码')['收盘价'].transform(lambda x: x.rolling(window=20, min_periods=5).mean())
        df['Above_MA20'] = df['收盘价'] > df['MA20']
        market_conditions = df.groupby('日期').agg(market_breadth_pct=('Above_MA20', 'mean')).reset_index()
        return market_conditions.set_index('日期').to_dict('index')

    def get_daily_risk_info(self, decision_date_str, portfolio_config_df):
        decision_date = pd.to_datetime(decision_date_str).normalize()
        if pd.isna(decision_date):
            return None

        score_market = self._calculate_market_score(decision_date)
        score_fund_flow, score_structure = self._calculate_portfolio_scores(decision_date, portfolio_config_df)

        weight_market, weight_fund_flow, weight_structure = 0.45, 0.35, 0.20
        position_factor = (score_market * weight_market +
                           score_fund_flow * weight_fund_flow +
                           score_structure * weight_structure)
        final_factor = np.clip(position_factor, 0.0, 1.0)

        return {
            "标题": "风控因子分析 (已优化)",
            "决策日期": decision_date_str,
            "市场宽度得分": f"{score_market:.2f}",
            "资金流得分": f"{score_fund_flow:.2f}",
            "持仓结构得分": f"{score_structure:.2f}",
            "综合建议仓位因子": f"{final_factor:.2f}"
        }

    def _calculate_market_score(self, decision_date):
        market_on_date = self.market_proxy_dict.get(decision_date, {})
        breadth = market_on_date.get('market_breadth_pct', 0.45)
        if breadth >= 0.50:
            return 1.0
        elif breadth <= 0.42:
            return 0.0
        else:
            return (breadth - 0.42) / 0.08

    def _calculate_portfolio_scores(self, decision_date, portfolio_config_df):
        df_portfolio = portfolio_config_df.copy()
        target_col = '超大单净流入-净占比(%)'
        fallback_col = '主力净流入-净占比(%)'

        def clean_flow(val):
            if pd.isna(val): return np.nan
            return float(str(val).replace('%', ''))

        used_col = None
        if target_col in df_portfolio.columns:
            used_col = target_col
        elif '超大单净流入-净占比' in df_portfolio.columns:
            used_col = '超大单净流入-净占比'
        elif fallback_col in df_portfolio.columns:
            used_col = fallback_col
        else:
            used_col = '主力净流入-净占比'

        if used_col in df_portfolio.columns:
            df_portfolio['calc_flow'] = df_portfolio[used_col].apply(clean_flow)
        else:
            df_portfolio['calc_flow'] = 0.0

        if '最优权重(%)' in df_portfolio.columns:
            df_portfolio['weight_float'] = df_portfolio['最优权重(%)'].astype(str).str.replace('%', '').astype(float) / 100
        elif '最优权重' in df_portfolio.columns:
            df_portfolio['weight_float'] = df_portfolio['最优权重']
        else:
            df_portfolio['weight_float'] = 0.0

        valid_flow = df_portfolio.dropna(subset=['calc_flow'])
        if valid_flow.empty or valid_flow['weight_float'].sum() == 0:
            weighted_inflow = 0
        else:
            weighted_inflow = (valid_flow['calc_flow'] * valid_flow['weight_float']).sum() / valid_flow['weight_float'].sum()

        if weighted_inflow >= 8.5:
            score_fund_flow = 1.0
        elif weighted_inflow <= 6.0:
            score_fund_flow = 0.2
        else:
            score_fund_flow = 0.2 + (weighted_inflow - 6.0) / 2.5 * 0.8

        top3_concentration = df_portfolio.nlargest(3, 'weight_float')['weight_float'].sum() * 100

        if 65.0 <= top3_concentration <= 74.0:
            score_structure = 1.0
        elif top3_concentration > 74.0:
            penalty = min(0.8, (top3_concentration - 74.0) / 16.0)
            score_structure = 1.0 - penalty
        else:
            score_structure = 0.6 + (max(0, top3_concentration - 40.0) / 25.0) * 0.4

        return score_fund_flow, score_structure


