# @title EEIQModel2025 初始化数据获取 (防超时优化版，适配新文件名)
import pandas as pd
import numpy as np
import os
import re
import warnings
import gc
import lightgbm as lgb
from sklearn.metrics import classification_report
from tqdm.auto import tqdm
from joblib import Parallel, delayed
from multiprocessing import cpu_count
from datetime import timedelta, datetime
import threading
import time

# --- 1. 定义防超时心跳机制 ---
keep_alive_active = True

def keep_alive_worker(interval=45):
    while keep_alive_active:
        timestamp = datetime.now().strftime('%H:%M:%S')
        print(f"💓 [Colab保活] 系统正在处理中，请勿关闭... ({timestamp})")
        time.sleep(interval)

def start_keep_alive():
    global keep_alive_active
    keep_alive_active = True
    t = threading.Thread(target=keep_alive_worker, args=(45,))
    t.daemon = True
    t.start()
    return t

def stop_keep_alive():
    global keep_alive_active
    keep_alive_active = False

def log_message(message):
    print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}")

warnings.filterwarnings("ignore")
tqdm.pandas()

# ==========================================
# 主程序开始
# ==========================================

heartbeat_thread = start_keep_alive()
log_message("--- 任务开始：EEIQModel 初始化数据获取 (已启动后台保活线程) ---")

try:
    # --- 3. 定义数据目录和文件模式 ---
    DATA_DIR = "/content/AIPEQModel2025/data/"
    SHEET_NAME = "Flow5DaysSort"   # 尝试读取的 sheet 名

    # 新文件名格式: EEIFlow_YYYYMMDD_YYYYMMDD.xlsx
    # 如果文件不存在 Flow5DaysSort sheet，会回退到第一个 sheet

    # --- 4. 扫描数据目录，识别符合新命名格式的文件，并保留最近72个 ---
    log_message("步骤 1: 扫描数据目录并准备文件列表...")
    matching_files = []
    removed_files = []

    if os.path.exists(DATA_DIR):
        valid_file_entries = []  # (filename, start_date, end_date)

        for file in os.listdir(DATA_DIR):
            match = re.fullmatch(r"EEIFlow_(\d{8})_(\d{8})\.xlsx", file)
            if match:
                start_date = match.group(1)
                end_date = match.group(2)
                valid_file_entries.append((file, start_date, end_date))
            else:
                # 不符合新格式的文件（如 EEIFlow.xlsx, EEIFlowETF.xlsx 等）
                removed_files.append(file)

        # 按结束日期降序排序，若相同则按开始日期降序
        valid_file_entries.sort(key=lambda x: (x[2], x[1]), reverse=True)

        if valid_file_entries:
            # 保留最近 72 个文件（与原逻辑中 max_n - 72 类似）
            keep_count = min(72, len(valid_file_entries))
            matching_files = [entry[0] for entry in valid_file_entries[:keep_count]]
            # 其余文件加入忽略列表
            for entry in valid_file_entries[keep_count:]:
                removed_files.append(entry[0])
        else:
            log_message("警告: 未找到符合 EEIFlow_YYYYMMDD_YYYYMMDD.xlsx 格式的文件。")
    else:
        log_message(f"警告: 目录 {DATA_DIR} 不存在。")

    # 排序保持稳定
    matching_files.sort()
    log_message(f"找到 {len(matching_files)} 个匹配的数据文件。根据限定条件已忽略文件: {removed_files}")

    if not matching_files:
        raise RuntimeError("没有找到数据文件，程序终止。")

    # --- 5. 定义加载函数（支持备选 sheet）---
    def load_data_file(filename):
        filepath = os.path.join(DATA_DIR, filename)
        try:
            return pd.read_excel(filepath, sheet_name=SHEET_NAME, engine='openpyxl')
        except:
            try:
                return pd.read_excel(filepath, sheet_name=0, engine='openpyxl')
            except Exception as e:
                print(f"加载文件 {filename} 失败: {e}")
                return None

    # --- 6. 并行加载文件 ---
    log_message(f"步骤 2: 开始并行加载 {len(matching_files)} 个文件（这可能需要一些时间）...")

    num_cores = min(4, cpu_count())
    all_data_frames = Parallel(n_jobs=num_cores, verbose=5)(
        delayed(load_data_file)(filename) for filename in matching_files
    )
    log_message("并行加载任务完成。")

    all_data_frames = [df for df in all_data_frames if df is not None]
    loaded_file_count = len(all_data_frames)

    if not all_data_frames:
        raise RuntimeError("所有文件加载失败，程序终止。")

    log_message(f"成功加载 {loaded_file_count} 个文件的数据。")

    # --- 7. 合并所有数据 ---
    log_message("步骤 3: 合并所有数据 (concat)...")
    df_combined = pd.concat(all_data_frames, ignore_index=True)
    log_message("数据合并完成。")

    # 释放内存
    del all_data_frames
    gc.collect()
    log_message("内存已释放。")

    # --- 8. 数据预处理 ---
    log_message("步骤 4: 数据预处理...")
    log_message("格式化 '代码' 列...")
    if '代码' in df_combined.columns:
        df_combined['代码'] = df_combined['代码'].apply(
            lambda x: str(x).zfill(6) if pd.notna(x) else x
        )
    else:
        raise ValueError("数据中缺少 '代码' 列。")

    log_message("按 '代码' 和 '日期' 去重...")
    if '代码' in df_combined.columns and '日期' in df_combined.columns:
        initial_rows = len(df_combined)
        df_combined.sort_values(
            by=['代码', '日期', 'PotScore'],
            ascending=[True, False, False],
            na_position='last',
            inplace=True
        )
        df_combined.drop_duplicates(subset=['代码', '日期'], keep='first', inplace=True)
        final_rows = len(df_combined)
        log_message(f"去重完成。删除了 {initial_rows - final_rows} 行。")
    else:
        raise ValueError("数据中缺少 '代码' 或 '日期' 列。")

    # --- 9. 从本地Excel获取UDI/GDI特征 ---
    log_message("\n步骤 5: 加载市场特征数据 (UDI & GDI)...")

    def get_market_data_from_excel(sheet_name):
        prefix = "UDI_" if sheet_name == "UDI" else "GDI_"
        try:
            file_path = "/content/skfigure.xlsx"
            if not os.path.exists(file_path):
                log_message(f"  > 警告: 文件 {file_path} 不存在。")
                return pd.DataFrame()

            data = pd.read_excel(file_path, sheet_name=sheet_name, usecols=['Date', 'Close', 'Percent'])
            if data.empty:
                return pd.DataFrame()

            data = data.rename(columns={'Close': f'{prefix}Close', 'Percent': f'{prefix}Percent'})
            data['Date'] = pd.to_datetime(data['Date'], errors='coerce')
            data = data.sort_values('Date', ascending=False).reset_index(drop=True)
            data['Date'] = data['Date'].dt.strftime('%Y-%m-%d')
            return data
        except Exception as e:
            log_message(f"  > 警告: 读取 '{sheet_name}' 出错: {e}")
            return pd.DataFrame()

    df_udi = get_market_data_from_excel("UDI")
    df_gdi = get_market_data_from_excel("GDI")

    # --- 10. 合并市场特征到主数据集 ---
    log_message("\n步骤 6: 合并市场特征到主数据集...")
    df_combined['日期'] = pd.to_datetime(df_combined['日期'], errors='coerce')
    df_combined = df_combined.dropna(subset=['日期'])

    if not df_udi.empty:
        df_udi['Date'] = pd.to_datetime(df_udi['Date'])
        df_combined = pd.merge(df_combined, df_udi, left_on='日期', right_on='Date', how='left')
        df_combined = df_combined.drop(columns=['Date'], errors='ignore')
        log_message(f"UDI合并完成。")

    # 填充 UDI/GDI 前向/后向
    for col in ['UDI_Close', 'UDI_Percent']:
        if col in df_combined.columns:
            df_combined[col] = df_combined[col].fillna(method='ffill').fillna(method='bfill')
            if df_combined[col].isna().any():
                df_combined[col] = df_combined[col].fillna(df_combined[col].mean())

    # --- 11. 加载并合并行业标签 (l2name) ---
    log_message("\n步骤 7: 加载并合并行业标签 (l2name)...")
    target_file_path = "/content/EEITarget.xlsx"

    try:
        if os.path.exists(target_file_path):
            df_l2name = pd.read_excel(target_file_path, sheet_name="ARTop", usecols=['代码', 'l2name'], engine='openpyxl')
            df_l2name['代码'] = df_l2name['代码'].apply(lambda x: str(x).zfill(6) if pd.notna(x) else x)
            df_l2name.drop_duplicates(subset=['代码'], keep='first', inplace=True)

            df_combined = pd.merge(df_combined, df_l2name, on='代码', how='left')
            df_combined['l2name'].fillna('未知行业', inplace=True)
            log_message(f"l2name 合并完成。")
        else:
            log_message(f"警告: {target_file_path} 不存在，跳过 l2name 合并。")
    except Exception as e:
        log_message(f"l2name 处理出错: {e}")

    log_message("\n--- 数据初始化流程全部完成 ---")
    log_message(f"最终数据集大小: {df_combined.shape[0]} 行, {df_combined.shape[1]} 列。")

except Exception as e:
    log_message(f"❌ 程序执行过程中发生严重错误: {e}")
    import traceback
    traceback.print_exc()

finally:
    stop_keep_alive()
    log_message("🏁 心跳线程已停止，Cell 执行结束。")


# @title 生成每日大成模型（循环所有交易日）

import pandas as pd
import numpy as np
import scipy.optimize as sco
import re
import json
import os
from datetime import datetime

# =========================
# 前置检查
# =========================
if 'df_combined' not in globals() or df_combined.empty:
    raise ValueError("❌ 错误：请先加载 df_combined（所有 EEIFlow 合并后的数据）")

# 统一日期格式
df_combined['日期'] = pd.to_datetime(df_combined['日期'])
df_combined = df_combined.sort_values(['代码', '日期']).reset_index(drop=True)

# =========================
# 辅助函数定义（与原代码一致）
# =========================
def repair_json_file(file_path):
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content_str = f.read()
    except Exception:
        return
    if not content_str.strip():
        return
    content_str_no_nan = re.sub(r'\bNaN\b', 'null', content_str, flags=re.IGNORECASE)
    try:
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content_str_no_nan)
        print(f"JSON文件格式校正完成: {file_path}")
    except Exception:
        pass

def optimize_portfolio_sharpe(df_full_data, stock_codes, last_day_date, risk_free_rate=0.015):
    df_portfolio = df_full_data[df_full_data['代码'].isin(stock_codes)].copy()
    price_pivot = df_portfolio.pivot_table(index='日期', columns='代码', values='收盘价').sort_index()
    log_returns = np.log(price_pivot / price_pivot.shift(1)).dropna()
    mean_returns = log_returns.mean() * 252
    cov_matrix = log_returns.cov() * 252
    num_assets = len(stock_codes)

    def neg_sharpe_ratio(weights, mean_returns, cov_matrix, risk_free_rate):
        p_return = np.sum(mean_returns * weights)
        p_std = np.sqrt(np.dot(weights.T, np.dot(cov_matrix, weights)))
        return -(p_return - risk_free_rate) / p_std if p_std != 0 else -np.inf

    constraints = ({'type': 'eq', 'fun': lambda w: np.sum(w) - 1})
    bounds = tuple((0, 1) for _ in range(num_assets))
    initial_guess = num_assets * [1. / num_assets,]
    opt_result = sco.minimize(neg_sharpe_ratio, initial_guess, args=(mean_returns, cov_matrix, risk_free_rate),
                              method='SLSQP', bounds=bounds, constraints=constraints)

    if not opt_result.success:
        return None, None

    optimal_weights = opt_result.x
    opt_return = np.sum(mean_returns * optimal_weights)
    opt_volatility = np.sqrt(np.dot(optimal_weights.T, np.dot(cov_matrix, optimal_weights)))
    opt_sharpe = (opt_return - risk_free_rate) / opt_volatility if opt_volatility != 0 else np.nan

    results_df = pd.DataFrame({'代码': price_pivot.columns, '最优权重': optimal_weights})

    # 提取最新数据（截至 last_day_date）
    latest_data = df_full_data[df_full_data['代码'].isin(stock_codes)].copy()
    latest_data = latest_data[latest_data['日期'] <= last_day_date]   # 只用到该日及之前的数据
    latest_data = latest_data.sort_values(['代码', '日期'])
    last_two_days = latest_data.groupby('代码').tail(2)
    last_two_days['涨跌幅'] = last_two_days.groupby('代码')['收盘价'].pct_change() * 100
    final_latest_data = last_two_days.groupby('代码').tail(1).copy()
    final_latest_data.rename(columns={'收盘价': '最近一日价格'}, inplace=True)

    columns_to_merge = ['代码', '名称', '最近一日价格', '涨跌幅', 'PotScore', '总净流入占比_5日总和', '主力净流入-净占比']
    for col in columns_to_merge:
        if col not in final_latest_data.columns:
            final_latest_data[col] = np.nan

    results_df = pd.merge(results_df, final_latest_data[columns_to_merge], on='代码', how='left')

    results_df['最优权重(%)'] = results_df['最优权重'].apply(lambda x: f"{x*100:.2f}%")
    results_df['涨跌幅(%)'] = results_df['涨跌幅'].apply(lambda x: f"{x:.2f}%" if pd.notna(x) else "N/A")
    results_df['总净流入占比_5日总和(%)'] = results_df['总净流入占比_5日总和'].apply(lambda x: f"{x:.2f}%" if pd.notna(x) else "N/A")
    results_df['主力净流入-净占比(%)'] = results_df['主力净流入-净占比'].apply(lambda x: f"{x:.2f}%" if pd.notna(x) else "N/A")

    results_df = results_df.sort_values(by='最优权重', ascending=False)
    performance = {'预期年化收益率': opt_return, '年化波动率(风险)': opt_volatility, '预期夏普比率': opt_sharpe}
    results_df['最后一日日期'] = last_day_date.strftime('%Y-%m-%d')

    output_columns = [
        '代码', '名称', '最后一日日期', '最优权重(%)', '最近一日价格',
        '涨跌幅(%)', 'PotScore', '总净流入占比_5日总和(%)',
        '主力净流入-净占比(%)'
    ]
    for col in output_columns:
        if col not in results_df.columns:
            results_df[col] = 'N/A'

    return results_df[output_columns], performance

class RiskControlFactor:
    def __init__(self, df_combined):
        self.df_combined = df_combined.copy()
        self.market_proxy_dict = self._precompute_market_proxy()

    def _precompute_market_proxy(self):
        df = self.df_combined
        df = df.sort_values(['代码', '日期'])
        if 'MA20' not in df.columns:
            df['MA20'] = df.groupby('代码')['收盘价'].transform(lambda x: x.rolling(window=20, min_periods=5).mean())
        df['Above_MA20'] = df['收盘价'] > df['MA20']
        market_conditions = df.groupby('日期').agg(market_breadth_pct=('Above_MA20', 'mean')).reset_index()
        return market_conditions.set_index('日期').to_dict('index')

    def get_daily_risk_info(self, decision_date_str, portfolio_config_df):
        decision_date = pd.to_datetime(decision_date_str, errors='coerce')
        if pd.isna(decision_date):
            return None

        score_market = self._calculate_market_score(decision_date)
        score_fund_flow, score_structure = self._calculate_portfolio_scores(decision_date, portfolio_config_df)

        weight_market, weight_fund_flow, weight_structure = 0.4, 0.3, 0.3
        raw_position_factor = (score_market * weight_market +
                               score_fund_flow * weight_fund_flow +
                               score_structure * weight_structure)

        atmosphere_coef = self._get_atmosphere_coefficient(decision_date)
        final_position_factor = raw_position_factor * atmosphere_coef

        return {
            "标题": "风控因子分析",
            "决策日期": decision_date_str,
            "市场宽度得分": f"{score_market:.2f}",
            "资金流得分": f"{score_fund_flow:.2f}",
            "持仓结构得分": f"{score_structure:.2f}",
            "市场氛围系数": f"{atmosphere_coef:.2f}",
            "综合建议仓位因子": f"{np.clip(final_position_factor, 0, 1):.2f}"
        }

    def _get_atmosphere_coefficient(self, decision_date):
        market_on_date = self.market_proxy_dict.get(decision_date, {})
        breadth = market_on_date.get('market_breadth_pct', 0.5)
        if breadth < 0.20:
            return 0.5
        elif breadth < 0.40:
            return 0.8
        else:
            return 1.0

    def _calculate_market_score(self, decision_date):
        market_on_date = self.market_proxy_dict.get(decision_date, {})
        breadth = market_on_date.get('market_breadth_pct', 0.0)
        if breadth >= 0.50:
            return 1.0
        elif 0.40 <= breadth < 0.50:
            return 0.2 + (breadth - 0.40) / 0.10 * 0.8
        else:
            return 0.2

    def _calculate_portfolio_scores(self, decision_date, portfolio_config_df):
        df_portfolio = portfolio_config_df.copy()
        target_col = '主力净流入-净占比(%)'
        if target_col not in df_portfolio.columns:
            target_col = '主力净流入-净占比'

        if target_col in df_portfolio.columns:
            df_portfolio['raw_inflow'] = pd.to_numeric(df_portfolio[target_col].astype(str).str.replace('%', ''), errors='coerce')
        else:
            df_portfolio['raw_inflow'] = 0.0

        df_portfolio['最优权重_float'] = df_portfolio['最优权重(%)'].astype(str).str.replace('%', '').astype(float) / 100
        valid_flow = df_portfolio.dropna(subset=['raw_inflow'])

        if valid_flow.empty or valid_flow['最优权重_float'].sum() == 0:
            weighted_inflow = 0
        else:
            weighted_inflow = (valid_flow['raw_inflow'] * valid_flow['最优权重_float']).sum() / valid_flow['最优权重_float'].sum()

        if weighted_inflow >= 2.0:
            score_fund_flow = 1.0
        elif -1.0 < weighted_inflow < 2.0:
            score_fund_flow = 0.2 + (weighted_inflow + 1.0) / 3.0 * 0.8
        else:
            score_fund_flow = 0.2

        top3_concentration = df_portfolio.nlargest(3, '最优权重_float')['最优权重_float'].sum() * 100
        if 68 <= top3_concentration <= 82:
            score_structure = 1.0
        elif top3_concentration < 68:
            score_structure = max(0.3, top3_concentration / 68)
        else:
            score_structure = max(0.3, 1 - (top3_concentration - 82) / 20)

        return score_fund_flow, score_structure

# =========================
# 主循环：对每个交易日生成模型
# =========================
all_dates = sorted(df_combined['日期'].unique())
print(f"共有 {len(all_dates)} 个交易日需要生成模型")

