                "标题": "该组合的预期历史表现",
                "预期年化收益率": f"{portfolio_performance['预期年化收益率']*100:.2f}%",
                "年化波动率(风险)": f"{portfolio_performance['年化波动率(风险)']*100:.2f}%",
                "预期夏普比率": f"{portfolio_performance['预期夏普比率']:.2f}",
                "raw_data": portfolio_performance
            }
        }
    }
    if risk_info:
        all_output_data['结果']['风控因子信息'] = risk_info

    json_filename = f'/content/流入模型_{date_str}.json'
    with open(json_filename, 'w', encoding='utf-8') as f:
        json.dump(all_output_data, f, ensure_ascii=False, indent=4)
    repair_json_file(json_filename)
    print(f"✅ 已生成 JSON 文件：{json_filename}")

print("\n🎉 所有日期处理完成！")


# @title Commit Model JSONs to GitHub AIPEQModel2025 (Root Directory, Force Commit)

import os
import glob
import shutil
import subprocess

# =========================
# 配置信息（请务必替换为你的新 GitHub PAT）
# =========================
GIT_USERNAME = "digital-era"
GIT_EMAIL = "digital_era@sina.com"
GIT_REPO_NAME = "AIPEQModel2025"
GIT_TARGET_BRANCH = "main"          # 若为 master 请修改
GIT_PAT = ""         # ⚠️ 请替换为你的新 Personal Access Token

repo_directory = f'/content/{GIT_REPO_NAME}'
search_directory = '/content/'
file_prefixes = ['大成模型_', '流入模型_']   # 注意后缀是下划线 + 日期

# =========================
# 1. 克隆仓库（如果本地不存在）
# =========================
if not os.path.exists(repo_directory):
    print(f"🚀 克隆仓库 {GIT_REPO_NAME} ...")
    clone_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
    result = subprocess.run(['git', 'clone', clone_url, repo_directory],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("克隆失败：", result.stderr)
        raise SystemExit
else:
    print(f"📁 仓库已存在，使用本地目录：{repo_directory}")

# =========================
# 2. 拉取最新代码（避免冲突）
# =========================
os.chdir(repo_directory)
print("拉取远程最新代码...")
subprocess.run(['git', 'pull'], capture_output=True, text=True)

# =========================
# 3. 搜索所有匹配的 JSON 文件
# =========================
print(f"在 {search_directory} 中搜索模型 JSON 文件...")
source_files = []
for prefix in file_prefixes:
    pattern = os.path.join(search_directory, f"{prefix}*.json")
    source_files.extend(glob.glob(pattern))

if not source_files:
    print("⚠️ 未找到任何匹配的 JSON 文件，但将继续强制提交（空提交）。")
else:
    print(f"找到 {len(source_files)} 个 JSON 文件：")
    for f in source_files:
        print(f"  - {os.path.basename(f)}")

    # =========================
    # 4. 复制文件到仓库根目录
    # =========================
    print("\n复制文件到仓库根目录...")
    for src in source_files:
        dst = os.path.join(repo_directory, os.path.basename(src))
        shutil.copy2(src, dst)
        print(f"  ✅ 复制 {os.path.basename(src)}")

# =========================
# 5. 设置 git 用户信息
# =========================
subprocess.run(['git', 'config', 'user.name', GIT_USERNAME], check=True)
subprocess.run(['git', 'config', 'user.email', GIT_EMAIL], check=True)

# =========================
# 6. 添加所有 JSON 文件（在根目录）
# =========================
subprocess.run(['git', 'add', '*.json'], check=True)

# 注意：无论是否有变更，都执行提交（使用 --allow-empty 确保空提交也能成功）
commit_message = "Add daily model JSON files (大成模型 & 流入模型) - force commit"
print("提交中（强制空提交）...")
subprocess.run(['git', 'commit', '--allow-empty', '-m', commit_message], check=True)
print("✅ 已提交本地 commit")

# =========================
# 7. 推送
# =========================
push_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
print("推送中...")
result = subprocess.run(['git', 'push', push_url, GIT_TARGET_BRANCH],
                        capture_output=True, text=True)
if result.returncode != 0:
    print("推送失败，错误信息：")
    print(result.stderr)
    # 尝试 master 分支
    print("尝试 master 分支...")
    result2 = subprocess.run(['git', 'push', push_url, 'master'],
                             capture_output=True, text=True)
    if result2.returncode != 0:
        print("master 分支也失败：", result2.stderr)
    else:
        print("✅ 推送成功（master 分支）")
else:
    print("✅ 推送成功（main 分支）")

print("\n🏁 任务完成。")




