    # --- 组合优化 ---
    print("开始计算最优投资组合...")
    df_upto_date = df_combined[df_combined['日期'] <= current_date].copy()
    optimal_portfolio_df, portfolio_performance = optimize_portfolio_sharpe(
        df_full_data=df_upto_date,
        stock_codes=top_10_codes,
        last_day_date=current_date
    )

